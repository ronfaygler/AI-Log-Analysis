# MongoDB
MONGO_ROOT_USERNAME=logsentinel
MONGO_ROOT_PASSWORD=changeme
MONGO_DATABASE=logsentinel

# Redis
REDIS_PASSWORD=changeme

# JWT & API
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
API_KEY_SALT=changeme
REDIS_QUEUE_NAME=logsentinel:jobs
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
LOGS_CACHE_TTL_SECONDS=30

# Worker / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
NOTIFY_WEBHOOK_URL=
BATCH_MAX_LOGS=25
BATCH_WINDOW_MS=10000

# Service ports (host mapping)
API_PORT=4000
WORKER_PORT=
FRONTEND_PORT=3000

# Demo mode (off by default) — adds a public, no-registration "Demo" account
# with a "generate demo logs" flow using canned (pre-written, zero-Claude-cost)
# data. See DECISIONS.md. Set VITE_DEMO_MODE=true in the frontend env to match.
DEMO_MODE=false
